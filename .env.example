# ===========================================================
# ZENN OS — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione chaves reais.
# Sem estas variáveis o sistema roda em DEMO MODE (localStorage).
# ===========================================================

# Google Places API (New) — https://developers.google.com/maps/documentation/places/web-service
# Restrinja a chave por HTTP referrer e habilite apenas "Places API (New)".
GOOGLE_MAPS_API_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Use SOMENTE a anon/publishable key (nunca a service_role no front-end).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# "local" (padrão) ou "supabase" para trocar a camada de persistência.
VITE_DATA_PROVIDER=local

# Meta Graph API — https://developers.facebook.com/docs/graph-api
# Use um token de acesso de app/usuário com as permissões necessárias.
META_APP_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
